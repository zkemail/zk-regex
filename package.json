{
  "name": "zk-regex-monorepo",
  "version": "2.2.2-alpha.1",
  "description": "ZK Regex: Verifiable Regular Expressions in Arithmetic Circuits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkemail/zk-regex.git"
  },
  "license": "MIT",
  "private": true,
  "workspaces": [
    "scripts",
    "circom",
    "compiler"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "test": "bun test --timeout 30000",
    "test:scripts": "cd scripts && bun test",
    "test:circom": "cd circom && bun test",
    "test:benchmarks": "cd benchmarks && bun test",
    "gen-regex:circom": "cd scripts && bun run gen-regex:circom",
    "gen-regex:noir": "cd scripts && bun run gen-regex:noir",
    "gen-inputs:noir": "cd scripts && bun run gen-inputs:noir",
    "build": "cd compiler && bun run build",
    "build-release": "cd compiler && bun run build-release",
    "install-hooks": "cp git-hooks/pre-push .git/hooks/ && chmod +x .git/hooks/pre-push",
    "postinstall": "bun run install-hooks",
    "bench": "bun run bench:circom-v2 && bun run bench:noir && bun run bench:circom-v1 && bun run bench:collect && bun run bench:outputs",
    "bench:circom-v1": "bun benchmarks/scripts/bench.ts --provider circom-v1",
    "bench:circom-v2": "bun benchmarks/scripts/bench.ts --provider circom-v2",
    "bench:noir": "bun benchmarks/scripts/bench.ts --provider noir-v2",
    "bench:collect": "bun benchmarks/scripts/collect-results.ts",
    "bench:outputs": "bun benchmarks/scripts/generate-outputs.ts",
    "bench:clean": "rm -rf benchmarks/results/* benchmarks/outputs/*"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}